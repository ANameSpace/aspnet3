{
  "info": {
    "name": "PSite3 Products API",
    "description": "Коллекция для тестирования ProductsApiController (api/products). Перед запуском проверьте значение переменной baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5001"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1. GET Список (пагинация)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "10" }
          ]
        },
        "description": "200 OK. Возвращает массив ProductDto, отсортированный по IdProduct."
      }
    },
    {
      "name": "2. GET По идентификатору",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        },
        "description": "200 OK с ProductDto, либо 404 Not Found."
      }
    },
    {
      "name": "3. POST Создать",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.idProduct) {",
              "    pm.collectionVariables.set('productId', data.idProduct);",
              "    console.log('Сохранён productId =', data.idProduct);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Тестовый товар\",\n    \"description\": \"Описание тестового товара\",\n    \"price\": 199.99,\n    \"categoryId\": 1,\n    \"image\": \"no-image.jpg\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        },
        "description": "201 Created + заголовок Location. Возвращает созданный ProductDto. Автоматически сохраняет productId в переменную коллекции."
      }
    },
    {
      "name": "4. PUT Полное обновление",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Обновлённое имя\",\n    \"description\": \"Новое описание товара\",\n    \"price\": 299.50,\n    \"categoryId\": 1,\n    \"image\": \"new-image.jpg\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        },
        "description": "204 No Content при успехе, 404 Not Found если записи нет. Требуются ВСЕ поля."
      }
    },
    {
      "name": "5. PATCH Частичное обновление",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"price\": 999.99\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        },
        "description": "204 No Content при успехе, 404 Not Found если записи нет. Передавайте только изменяемые поля."
      }
    },
    {
      "name": "6. DELETE Удалить",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        },
        "description": "204 No Content при успехе, 404 Not Found если записи нет."
      }
    }
  ]
}
