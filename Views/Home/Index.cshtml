@model IEnumerable<PSite3.Models.Product>
@{
    ViewData["Title"] = "Каталог";
}

<div class="cart-container">
    <h1 class="page-title">
        <span class="material-icons-round">shopping_bag</span>
        <span>Каталог товаров</span>
    </h1>

    <div class="product-grid">
        @foreach (var product in Model)
        {
            var cartQuantity = ViewBag.CartItems != null &&
            ViewBag.CartItems.ContainsKey(product.IdProduct) ?
            ViewBag.CartItems[product.IdProduct] : 0;

            <div class="product-card">
                <span class="product-category">
                    @(product.Category?.Name ?? "Без категории")
                </span>

                <h3 class="product-name">@product.Name</h3>

                <p class="product-description">
                    @(!string.IsNullOrEmpty(product.Description) ? product.Description : "Описание отсутствует")
                </p>

                <div class="product-price">
                    @product.Price.ToString("0.00") <small>₽</small>
                </div>

                @if (cartQuantity > 0)
                {
                    <form asp-controller="Cart" asp-action="Update" method="post" style="display: block; margin-top: 0.75rem;">
                        <input type="hidden" name="productId" value="@product.IdProduct" />
                        <input type="hidden" name="quantity" value="0" />
                        <button type="submit" class="btn btn-danger" style="width: 100%;">
                            <span class="material-icons-round" style="font-size: 1rem;">delete</span>
                            <span>Удалить из корзины</span>
                        </button>
                    </form>
                }
                else
                {
                    <form asp-controller="Cart" asp-action="Update" method="post">
                        <input type="hidden" name="productId" value="@product.IdProduct" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn btn-primary" style="width: 100%;">
                            <span class="material-icons-round">add_shopping_cart</span>
                            <span>В корзину</span>
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-cart-icon">
                <span class="material-icons-round">inventory_2</span>
            </div>
            <h2>Товары не найдены</h2>
            <p>Каталог пока пуст или по вашему запросу ничего не найдено</p>
        </div>
    }
</div>