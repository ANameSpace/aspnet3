@model IEnumerable<PSite3.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<h1>Данные таблицы Order</h1>

<a class="btn btn-primary" asp-action="Create">Добавить заказ</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Код пользователя</th>
            <th>Дата заказа</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdOrder</td>
                <td>@m.UserId</td>
                <td>@m.OrderDate</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdOrder">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdOrder">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>