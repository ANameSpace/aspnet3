@model IEnumerable<PSite3.Models.OrderItem>
@{
    ViewData["Title"] = "OrderItems";
}

<h1>Данные таблицы OrderItem</h1>

<a class="btn btn-primary" asp-action="Create">Добавить позицию заказа</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Код заказа</th>
            <th>Код продукта</th>
            <th>Кол-во</th>
            <th>Цена</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdCartItem</td>
                <td>@m.OrderId</td>
                <td>@m.ProductId</td>
                <td>@m.Quantity</td>
                <td>@m.Price</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdCartItem">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdCartItem">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>