@model PSite3.Models.CartItem
@{
    ViewData["Title"] = "CartItems";
}

<h1>Уверены?</h1>

<p>Вы удалите предмет с ID <b>@Model.IdCartItem</b>.</p>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="IdCartItem" />
    <br />
    <button class="btn btn-danger" type="submit">Удалить</button>
    <a class="btn btn-secondary" asp-action="Index">Отменить</a>
</form>