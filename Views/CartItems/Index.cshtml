@model IEnumerable<PSite3.Models.CartItem>
@{
    ViewData["Title"] = "CartItems";
}
<h1>Данные таблицы CartItem</h1>

<a class="btn btn-primary" asp-action="Create">Добавить продукт</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Код корзины</th>
            <th>Код продукта</th>
            <th>Кол-во</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var m in Model)
        {
            <tr>
                <td>@m.IdCartItem</td>
                <td>@m.CartId</td>
                <td>@m.ProductId</td>
                <td>@m.Quantity</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdCartItem">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdCartItem">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>