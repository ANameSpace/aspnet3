@model IEnumerable<PSite3.Models.Category>
@{
    ViewData["Title"] = "Categories";
}
<h1>Данные таблицы Category</h1>

<a class="btn btn-primary" asp-action="Create">Добавить категорию</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Название</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdCategory</td>
                <td>@m.Name</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdCategory">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdCategory">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>