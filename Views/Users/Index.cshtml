@model IEnumerable<PSite3.Models.User>
@{
    ViewData["Title"] = "Users";
}

<h1>Данные таблицы User</h1>

<a class="btn btn-primary" asp-action="Create">Добавить пользователя</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Логин</th>
            <th>Хэш пароля</th>
            <th>Код роли</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdUser</td>
                <td>@m.Login</td>
                <td>@m.Hash</td>
                <td>@m.RoleId</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdUser">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdUser">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>