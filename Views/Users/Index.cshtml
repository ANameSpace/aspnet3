@model IEnumerable<PSite3.Models.User>
@{
    ViewData["Title"] = "Users";
}

<h1>Данные таблицы User</h1>

<a class="btn btn-primary" asp-action="Create">Добавить пользователя</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Имя</th>
            <th>Email</th>
            <th>Хэш</th>
            <th>Роль</th>
            <th>Активен</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdUser</td>
                <td>@m.UserName</td>
                <td>@m.Email</td>
                <td>@m.Hash</td>
                <td>@m.RoleId</td>
                <td>
                    @if (m.IsActive)
                    {
                        <span style="color: green;">&#10004; Да</span>
                    }
                    else
                    {
                        <span style="color: red;">&#10006; Нет</span>
                    }
                </td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-action="Edit" asp-route-id="@m.IdUser">Изменить</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@m.IdUser">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>