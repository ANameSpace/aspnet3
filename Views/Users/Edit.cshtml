@model PSite3.Models.User
@{
    ViewData["Title"] = "Users";
    var roles = ViewBag.Roles as IEnumerable<PSite3.Models.Role>;
}
<h1>Edit user</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdUser" />

    <div>
        <label asp-for="UserName"></label>
        <input asp-for="UserName" />
        <span asp-validation-for="UserName"></span>
    </div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="RoleId"></label>
        <select asp-for="RoleId">
            @foreach (var r in (roles ?? Enumerable.Empty<PSite3.Models.Role>()))
            {
                <option value="@r.IdRole">@r.Name</option>
            }
        </select>
        <span asp-validation-for="RoleId"></span>
    </div>

    <div>
        <label asp-for="IsActive"></label>
        <input asp-for="IsActive" type="checkbox" />
        <span asp-validation-for="IsActive"></span>
    </div>

    <br />
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>