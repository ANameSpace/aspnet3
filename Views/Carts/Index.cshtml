@model IEnumerable<PSite3.Models.Cart>
@{
    ViewData["Title"] = "Carts";
}
<h1>Данные таблицы Cart</h1>

<a class="btn btn-primary" asp-action="Create">Добавить корзину</a>

<table class="table">
    <thead>
        <tr>
            <th>Код</th>
            <th>Код пользователя</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.IdCart</td>
                <td>@m.UserId</td>
                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@m.IdCart">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@m.IdCart">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>